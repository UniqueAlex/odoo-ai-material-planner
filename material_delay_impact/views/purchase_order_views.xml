<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_delay_impact" model="ir.ui.view">
        <field name="name">purchase.order.delay.impact</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="mb-3" invisible="not mdic_can_open_plan">
                <field name="mdic_can_open_plan" invisible="1"/>
                <button name="action_mdic_common_plan" type="object" string="Material impact and shared plan"
                        class="btn btn-outline-primary" icon="fa-exchange"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
